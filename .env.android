# .env.android：Android App 构建（vite --mode android）用的默认后端。
# 这些是 Folia 作者公开部署的实例（folia.izuna.top 网页版用的同一套），App 设置里填了自己的服务器时不再用它们。
VITE_NETEASE_API_BASE=https://folia-api-enhanced.izuna.top
VITE_KUGOU_API_BASE=https://ku-gou-music-api-kohl-two.vercel.app
VITE_QQ_API_BASE=https://folia.izuna.top/api/qq
# AI 主题、歌词分词与歌词代理（/api/*）
VITE_APP_SERVER_BASE=https://folia.izuna.top
VITE_AI_PROVIDER=google
